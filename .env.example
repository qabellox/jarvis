# =============================================================================
# JARVIS Desktop Client - Environment Configuration
# Copy this file to `.env` at the project root. The desktop client is a thin
# shell: all intelligence lives in the JARVIS Core (see jarvis-core/.env).
# =============================================================================

# --- JARVIS Core connection --------------------------------------------------
# Where the Core's WebSocket server lives (clients connect here).
JARVIS_HOST=127.0.0.1
JARVIS_CORE_WS_PORT=8767
# Or set the full URL explicitly:
# JARVIS_CORE_WS_URL=ws://127.0.0.1:8766

# --- Voice -------------------------------------------------------------------
# TTS uses Microsoft Edge online voices; STT uses the Web Speech API.
JARVIS_TTS_VOICE=en-US-ChristopherNeural

# --- Client ------------------------------------------------------------------
JARVIS_RECONNECT_MS=3000
