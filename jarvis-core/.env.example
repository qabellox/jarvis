# =============================================================================
# JARVIS CORE - Environment Configuration
# Copy to `.env` inside jarvis-core/ and fill in secrets. Never commit `.env`.
# =============================================================================

# --- DeepSeek (the Brain) ---------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Core servers -----------------------------------------------------------
# JARVIS_WS_PORT       : ESP32 boards connect here (the real-world gateway).
# JARVIS_CORE_WS_PORT  : clients (Electron, Telegram, web) connect here.
# JARVIS_HTTP_PORT     : simple REST API.
JARVIS_WS_PORT=8765
JARVIS_CORE_WS_PORT=8767
JARVIS_HTTP_PORT=8080
JARVIS_HOST=0.0.0.0

# --- Research database & memory --------------------------------------------
JARVIS_DATA_DIR=

# --- Federation -------------------------------------------------------------
JARVIS_FL_ALGORITHM=FedAvg
JARVIS_MAX_TOOL_ITERATIONS=6

# --- Python tool (execute_python) ------------------------------------------
# Only scripts inside this directory may be executed by the agent.
JARVIS_PYTHON_ALLOWED_DIR=./scripts
JARVIS_PYTHON_TIMEOUT_MS=30000

# --- Autonomy ---------------------------------------------------------------
# Cron expressions for proactive monitoring and self-reflection.
JARVIS_PROACTIVE_CRON=0 * * * *
JARVIS_REFLECTION_CRON=0 3 * * *
JARVIS_NODE_TIMEOUT_MS=30000

# --- Telegram (optional, for the send_telegram_message tool) ----------------
# Only needed if you want the Core to push directly to Telegram without the
# telegram-bot process running. Otherwise the bot relays messages.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
