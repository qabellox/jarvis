{
    "name": "jarvis-core",
    "version": "1.0.0",
    "description": "JARVIS Core - the autonomous 'brain' service. Owns the agent runtime, tool registry, ESP32 gateway, federated learning core, memory and research database. Serves every client (Electron, Telegram, web, CLI) over WebSocket + REST.",
    "license": "MIT",
    "private": true,
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "dotenv": "^16.4.7",
        "node-cron": "^3.0.3",
        "sql.js": "^1.13.0",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.7",
        "@types/node-cron": "^3.0.11",
        "@types/ws": "^8.5.13",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
