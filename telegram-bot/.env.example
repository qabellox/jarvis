# =============================================================================
# JARVIS Telegram Bot - Environment Configuration
# Copy to `.env` inside telegram-bot/ and fill in your secrets.
# =============================================================================

# --- Telegram ---------------------------------------------------------------
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to talk to JARVIS (empty = allow anyone).
TELEGRAM_ALLOWED_CHAT_IDS=

# --- JARVIS Core ------------------------------------------------------------
JARVIS_CORE_WS_URL=ws://127.0.0.1:8767
JARVIS_VERSION=1.1.0
